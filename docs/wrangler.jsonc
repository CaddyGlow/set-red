{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "set-docs",
  "compatibility_date": "2026-07-12",
  "assets": {
    "directory": "./.vitepress/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "docs.set.red",
      "custom_domain": true
    }
  ]
}
